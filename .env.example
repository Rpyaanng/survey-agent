# Used by docker-compose.yml for the backend service. See backend/.env.example for every option.
SECRET_KEY=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000
# Local compose runs over plain HTTP; allow instant plan switching without Stripe.
ALLOW_DEV_BILLING=true

# Optional integrations
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
RESEND_API_KEY=
EMAIL_FROM=Survey Agent <surveys@yourdomain.com>
