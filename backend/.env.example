# --- Core -------------------------------------------------------------------
APP_ENV=development                     # development | production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///survey_agent.db  # postgresql://user:pass@host:5432/survey_agent in production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# AUTH_COOKIE_SECURE=true               # defaults to true in production
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0   # share rate limits across workers

# --- AI (optional) ----------------------------------------------------------
# Without a key, a deterministic offline engine powers chat, generation and imports.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# AI_REFUSAL_FALLBACK=true

# --- Voice & phone interviews (optional, ElevenLabs Conversational AI) -------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=             # for outbound phone calls (Twilio number imported into ElevenLabs)
ELEVENLABS_WEBHOOK_SECRET=              # post-call webhook HMAC secret

# --- Billing (optional, Stripe) -----------------------------------------------
# Without Stripe keys, plan changes apply instantly (dev mode; disabled in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# --- Email (optional, Resend) --------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Survey Agent <surveys@yourdomain.com>
